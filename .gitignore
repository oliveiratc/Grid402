# Git ignore para Grid402
.env
.env.*
!.env.example
*.log
dist/

# Chaves e certificados
*.pem
*.key
id.json

# Node modules
node_modules/
mcp/node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
python/.venv/
python/build/
python/*.egg-info/
python/dist/

# Dados locais e temporários
grid402_storage/
public_html/private_data/**
!public_html/private_data/.htaccess
scripts/bazaar_watch_state.json


