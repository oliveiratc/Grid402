# Grid402 - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env na raiz (acima de public_html) ou para private_data/.env

GRID402_WALLET_ADDRESS=0xa592625adbceb8e025ac383f1a3fd8ebb6a63f90
GRID402_SOLANA_WALLET_ADDRESS=CSgJyQTwehb3vF2vbsDMdUuBPdcuvx1vdEEhGvVCCF8C
GRID402_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Seed base58 (32 bytes) do keypair ed25519 que assina o addr-proof Solana do PayCensus Trust (vid=12).
# Usada por scripts/paycensus_bind_solana.py; qualquer keypair seu serve, o bound eh o que voce assina.
GRID402_SOLANA_SIGNING_KEY=
# Nonce de uso unico exibido no portal da conta PayCensus (login por e-mail). Expira/queima a cada bind.
# Aceita "paycensus-verify=<hex>" ou apenas o <hex>. Alternativa: --nonce na linha de comando.
GRID402_PAYCENSUS_NONCE=
# verification id do perfil no PayCensus (default do script: 12, o do grid402.online).
GRID402_PAYCENSUS_VID=12
GRID402_CRON_SECRET=troque_por_um_secret_longo_aleatorio
GRID402_BASE_RPC_URL=https://mainnet.base.org
GRID402_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
GRID402_USDC_REQUIRED_RAW=5000
GRID402_USDC_DECIMALS=6
GRID402_PRICE_DISPLAY=0.0050
GRID402_TIMEOUT_MS=2800
GRID402_CONNECT_TIMEOUT_MS=1500
GRID402_PROBE_USER_AGENT=Grid402-Telemetry-Probe/1.0 (+https://grid402.online)

# Cota de Sandbox (consultas gratuitas por dia por IP antes de conversao para Pix ou x402 pago)
GRID402_SANDBOX_RATE_LIMIT=3
GRID402_SANDBOX_WINDOW_SECONDS=86400

# Ponte Nativa RapidAPI Proxy (copie de RapidAPI Studio -> Gateway -> Firewall Settings -> X-RapidAPI-Proxy-Secret)
# Nunca versionar o valor real no Git. Libera apenas endpoints de consulta (bloqueado em /api/v1/pass).
GRID402_RAPIDAPI_PROXY_SECRET=

# Chave do Oraculo (Proof of Data, ECDSA secp256k1). NUNCA usar o default do repo em producao.
# Gere um par novo (openssl ecparam -name secp256k1 -genkey) e cole PEM com \n.
GRID402_ORACLE_PRIVATE_KEY=
GRID402_ORACLE_PUBLIC_KEY=
GRID402_ORACLE_WALLET=0xa592625adbceb8e025ac383f1a3fd8ebb6a63f90
GRID402_TELEGRAM_BOT_TOKEN=
GRID402_TELEGRAM_CHAT_ID=


# Facilitador x402 para pagamentos padrao (EIP-3009). Modos: disabled (padrao) | verify_only (so homologacao, nao fatura) | settle (producao - fatura de verdade)
# IMPORTANTE: para trazer faturamento real, use GRID402_FACILITATOR_MODE=settle com credenciais CDP validas.
GRID402_FACILITATOR_MODE=disabled
GRID402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform
GRID402_FACILITATOR_VERIFY_PATH=/v2/x402/verify
GRID402_FACILITATOR_SETTLE_PATH=/v2/x402/settle
GRID402_CDP_API_KEY_ID=
# Chave EC (PEM, use \n para quebras de linha) ou Ed25519 (base64). Nunca versionar.
GRID402_CDP_API_KEY_SECRET=

# --- Perfil A: HOMOLOGACAO em Base Sepolia (testnet, facilitador publico x402.org, sem credenciais) ---
# GRID402_X402_NETWORK=base-sepolia
# GRID402_FACILITATOR_MODE=settle
# GRID402_FACILITATOR_URL=https://x402.org/facilitator
# GRID402_FACILITATOR_VERIFY_PATH=/verify
# GRID402_FACILITATOR_SETTLE_PATH=/settle
# GRID402_CDP_API_KEY_ID=
# GRID402_CDP_API_KEY_SECRET=
# O USDC de teste fica em 0x036CbD53842c5426634e7929541eC2318f3dCF7e (Base Sepolia).

# --- Perfil B: PRODUCAO em Base Mainnet com facilitador publico PayAI (sem credenciais, extensao bazaar) ---
# Nota de margem: PayAI cobra ~0.00166 USDC por settle em Base mainnet; os precos vigentes
# do Grid402 (0.0050 a 0.0500 USDC) ja cobrem a taxa com folga. Para zero taxa por chamada, use Session Pass.
# GRID402_FACILITATOR_MODE=settle
# GRID402_FACILITATOR_URL=https://facilitator.payai.network
# GRID402_FACILITATOR_VERIFY_PATH=/verify
# GRID402_FACILITATOR_SETTLE_PATH=/settle
# GRID402_CDP_API_KEY_ID=
# GRID402_CDP_API_KEY_SECRET=

# --- Perfil C: PRODUCAO com Coinbase CDP (KYT/OFAC; requer conta Coinbase Developer Platform) ---
# GRID402_FACILITATOR_MODE=settle
# GRID402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform
# GRID402_FACILITATOR_VERIFY_PATH=/v2/x402/verify
# GRID402_FACILITATOR_SETTLE_PATH=/v2/x402/settle
# GRID402_CDP_API_KEY_ID=...
# GRID402_CDP_API_KEY_SECRET=...

# Mercado Pago (Checkout Pix + Cartao para Session Pass em BRL)
# Gere em https://www.mercadopago.com.br/developers/panel/app
GRID402_MP_ACCESS_TOKEN=
GRID402_MP_WEBHOOK_SECRET=
# Defina true apenas em homologacao/testes locais para simular Pix/Checkout Pro sem token real
GRID402_MP_SANDBOX=false
