# Grid402 - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env na raiz (acima de public_html) ou para private_data/.env

GRID402_WALLET_ADDRESS=0xa31c31069c43ac1c0075a93c325b0dcd7744356c
GRID402_CRON_SECRET=defina_um_token_secreto_super_seguro_aqui_123
GRID402_BASE_RPC_URL=https://mainnet.base.org
GRID402_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
GRID402_USDC_REQUIRED_RAW=500
GRID402_USDC_DECIMALS=6
GRID402_PRICE_DISPLAY=0.0005
GRID402_TIMEOUT_MS=2800
GRID402_CONNECT_TIMEOUT_MS=1500
GRID402_PROBE_USER_AGENT=Grid402-Telemetry-Probe/1.0 (+https://www.grid402.com.br)

# Cota de Sandbox (consultas gratuitas por hora por IP antes de conversao para x402 pago)
GRID402_SANDBOX_RATE_LIMIT=30

# Chave do Oraculo (Proof of Data, ECDSA secp256k1). NUNCA usar o default do repo em producao.
# Gere um par novo (openssl ecparam -name secp256k1 -genkey) e cole PEM com \n.
GRID402_ORACLE_PRIVATE_KEY=
GRID402_ORACLE_PUBLIC_KEY=
GRID402_ORACLE_WALLET=0xa31c31069c43ac1c0075a93c325b0dcd7744356c
GRID402_TELEGRAM_CHAT_ID=


# Facilitador x402 para pagamentos padrao (EIP-3009). Modos: disabled (padrao) | verify_only (so homologacao, nao fatura) | settle (producao - fatura de verdade)
# IMPORTANTE: para trazer faturamento real, use GRID402_FACILITATOR_MODE=settle com credenciais CDP validas.
GRID402_FACILITATOR_MODE=disabled
GRID402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform
GRID402_CDP_API_KEY_ID=
# Chave EC (PEM, use \n para quebras de linha) ou Ed25519 (base64). Nunca versionar.
GRID402_CDP_API_KEY_SECRET=
