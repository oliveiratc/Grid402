# Grid402 - Configurações LiteSpeed / Apache
Options -Indexes
ServerSignature Off

# Proteção de arquivos sensíveis
<FilesMatch "^\.(env|git)|config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeçalhos de Segurança e CORS para M2M
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Payment"
    Header set Access-Control-Expose-Headers "WWW-Authenticate, X-Authenticate, X-Accept-Payment, X-Payment-Status, X-Payment-Amount"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Roteamento amigável para APIs e Oráculo
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Responder pre-flight OPTIONS para CORS imediatamente
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=204,L]

    # Roteamento de rotas amigáveis para index.php e badges
    RewriteRule ^badge/([a-zA-Z0-9_\-]+)\.svg$ badge.php?target=$1 [QSA,L]
    RewriteRule ^badge/([a-zA-Z0-9_\-]+)/?$ badge.php?target=$1 [QSA,L]
    RewriteRule ^telemetry/?$ index.php?detail=true [QSA,L]
    RewriteRule ^status/?$ index.php [QSA,L]

    # Se o arquivo ou diretório existir, serve direto (ex: llms.txt, collector.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback para index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
