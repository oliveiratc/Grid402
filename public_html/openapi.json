{
  "openapi": "3.1.0",
  "info": {
    "title": "Grid402 // Public Data e Network Utilities Hub",
    "version": "2.5.0",
    "description": "High-performance autonomous M2M public data and network utilities oracle designed for AI agents, crawlers, and automation pipelines. Settled via the x402 protocol with Base Mainnet USDC micropayments (US$ 0.0005 standard, US$ 0.0020 corporate CNPJ).",
    "contact": {
      "name": "Grid402 Support",
      "url": "https://www.grid402.com.br",
      "email": "contato@grid402.com.br"
    },
    "license": {
      "name": "MIT e AS-IS Public Data Terms",
      "url": "https://www.grid402.com.br/terms"
    }
  },
  "servers": [
    {
      "url": "https://orangered-jackal-900744.hostingersite.com",
      "description": "Hostinger Cloud Production / Active Live Cluster"
    },
    {
      "url": "https://www.grid402.com.br",
      "description": "Primary Production Domain"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Free", "description": "Free discovery and aggregated status (No payment required)" },
    { "name": "Forex", "description": "Real-time foreign exchange rates (USD, EUR, GBP to BRL)" },
    { "name": "Crypto", "description": "Spot crypto market tickers (BTC, ETH, SOL, USDC, BASE)" },
    { "name": "DNS", "description": "Authoritative RFC 1035 DNS records resolution" },
    { "name": "SSL", "description": "Port 443 TLS/SSL certificate inspector and X.509 chain analyzer" },
    { "name": "ASN", "description": "BGP routing metadata, ASN number, organization and country" },
    { "name": "CEP", "description": "Brazilian postal resolution and official municipal IBGE code" },
    { "name": "CNPJ", "description": "Brazilian Federal Revenue corporate registration data and CNAE" },
    { "name": "Indicators", "description": "Official Brazilian economic indicators (Selic, CDI, and IPCA)" },
    { "name": "Holidays", "description": "National holidays and banking calendar (ANBIMA and Febraban)" },
    { "name": "Verification", "description": "Stateless cryptographic oracle proof verification" },
    { "name": "Legal", "description": "Terms of Service and LGPD privacy policy" }
  ],
  "paths": {
    "/api/v1/summary": {
      "get": {
        "summary": "Consolidated Hub Status e Market Summary (Free)",
        "description": "Returns operational health and latest cached sample metrics across all 6 micro-services. Zero payment required.",
        "tags": ["Free"],
        "responses": {
          "200": {
            "description": "Hub operational status and service catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forex": {
      "get": {
        "summary": "Foreign Exchange Rates (USD, EUR, GBP to BRL)",
        "description": "Returns real-time bid, ask, and daily percentage change for major fiat currencies to BRL. Requires x402 micropayment on Base.",
        "tags": ["Forex"],
        "security": [{ "x402Payment": [] }],
        "responses": {
          "200": {
            "description": "Forex rates returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForexResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required via x402 Protocol",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402Challenge"
                }
              }
            }
          },
          "403": {
            "description": "Replay Attack Detected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/crypto": {
      "get": {
        "summary": "Spot Cryptocurrency Tickers",
        "description": "Returns spot prices in USD for BTC, ETH, SOL, USDC, and Base ecosystem tokens with 24h variation. Requires x402 micropayment on Base.",
        "tags": ["Crypto"],
        "security": [{ "x402Payment": [] }],
        "responses": {
          "200": {
            "description": "Crypto tickers returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CryptoResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/dns": {
      "get": {
        "summary": "DNS Records Resolution",
        "description": "Resolves authoritative DNS records (A, AAAA, MX, TXT, NS, CNAME) for any valid domain name. Requires x402 micropayment on Base.",
        "tags": ["DNS"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "description": "Target domain name to resolve (e.g., github.com)",
            "schema": {
              "type": "string",
              "example": "github.com"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DNS records successfully resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DnsResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/ssl": {
      "get": {
        "summary": "TLS/SSL Certificate Inspector",
        "description": "Performs a direct TLS handshake on port 443 to extract X.509 certificate validity, issuer, SANs, and remaining days. Requires x402 micropayment on Base.",
        "tags": ["SSL"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "host",
            "in": "query",
            "required": true,
            "description": "Hostname to inspect on port 443 (e.g., base.org)",
            "schema": {
              "type": "string",
              "example": "base.org"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "TLS inspection report returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SslResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/asn": {
      "get": {
        "summary": "BGP ASN e IP Intelligence",
        "description": "Resolves Autonomous System Number (ASN), BGP organization, and country for a given IP address. Requires x402 micropayment on Base.",
        "tags": ["ASN"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "required": false,
            "description": "IPv4 or IPv6 address to lookup (default: caller IP)",
            "schema": {
              "type": "string",
              "example": "1.1.1.1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ASN and routing metadata returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsnResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/cep": {
      "get": {
        "summary": "Brazilian CEP e IBGE Municipal Code",
        "description": "Resolves public street, neighborhood, city, state, and official IBGE municipal code from an 8-digit Brazilian postal code (CEP). Requires x402 micropayment on Base.",
        "tags": ["CEP"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "description": "8-digit Brazilian postal code (CEP)",
            "schema": {
              "type": "string",
              "example": "01310100"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Address and IBGE code returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CepResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/cnpj": {
      "get": {
        "summary": "Brazilian Federal Revenue Corporate CNPJ Lookup",
        "description": "Retrieves public corporate registration data, status, CNAE economic activities, and address from Brazilian Receita Federal. Requires x402 micropayment of 0.0020 USDC on Base.",
        "tags": ["CNPJ"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "cnpj",
            "in": "query",
            "required": true,
            "description": "14-digit Brazilian CNPJ number (with or without formatting)",
            "schema": {
              "type": "string",
              "example": "00000000000191"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Corporate registration data returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CnpjResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid CNPJ format or checksum failure"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/indicators": {
      "get": {
        "summary": "Official Brazilian Economic Indicators",
        "description": "Returns official interest rates (Selic target, Selic daily, CDI annual, CDI daily) and inflation metrics (IPCA 12-month accumulated and monthly) from the Central Bank of Brazil (BCB) and IBGE. Settled via x402 on Base (0.0005 USDC). Free teaser preview available on 402 challenge.",
        "tags": ["Indicators"],
        "security": [{ "x402Payment": [] }],
        "responses": {
          "200": {
            "description": "Economic indicators returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorsResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/holidays": {
      "get": {
        "summary": "Brazilian National Holidays and Banking Calendar",
        "description": "Returns full official schedule of Brazilian national holidays and non-banking days (ANBIMA and Febraban) for a given year (1900-2100). Computes mobile holidays deterministically using Meeus algorithm. Settled via x402 on Base (0.0005 USDC). Free teaser preview with next holiday available on 402 challenge.",
        "tags": ["Holidays"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Four-digit calendar year (e.g., 2026). Defaults to current year.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100,
              "example": 2026
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar of holidays returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolidaysResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid year parameter (must be between 1900 and 2100)"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/workdays": {
      "get": {
        "summary": "ANBIMA Financial Workdays Calculator",
        "description": "Calculates Brazilian banking workdays according to official ANBIMA convention. Supports 3 operation modes: date range counting (exclusive start, inclusive end), maturity date projection (+/- N workdays), and single-date workday verification. Settled via x402 on Base (0.0005 USDC) or free in Sandbox mode.",
        "tags": ["Workdays"],
        "security": [{ "x402Payment": [] }],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "description": "Initial reference date in ISO 8601 format (YYYY-MM-DD). Defaults to today.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-12-24"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "End date in ISO 8601 format (YYYY-MM-DD) for interval counting mode.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-12-28"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Number of workdays to add (positive) or subtract (negative) for projection mode (max 5000).",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 5
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Single date in ISO 8601 format (YYYY-MM-DD) for single-date check mode.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-12-25"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workdays calculation returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkdaysResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date format, range or displacement exceeding limits"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        }
      }
    },
    "/api/v1/verify": {
      "post": {
        "summary": "Stateless Oracle Proof Verification",
        "description": "Verifies the ECDSA secp256k1 cryptographic signature and canonical SHA-256 data hash of a response payload previously emitted by the Grid402 Oracle. Stateless, zero-DB, memory execution in less than 1 ms. Max payload size 64 KB.",
        "tags": ["Verification"],
        "requestBody": {
          "required": true,
          "description": "Arbitrary Grid402 response JSON containing the _oracle_proof block",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification evaluated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed JSON payload"
          },
          "413": {
            "description": "Payload exceeds maximum limit of 64 KB"
          }
        }
      },
      "get": {
        "summary": "Stateless Oracle Proof Verification (Query Param)",
        "description": "Convenience GET endpoint accepting a URL-encoded JSON string in the payload query parameter.",
        "tags": ["Verification"],
        "parameters": [
          {
            "name": "payload",
            "in": "query",
            "description": "URL-encoded JSON response string containing _oracle_proof",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verification evaluated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed JSON payload"
          }
        }
      }
    },
    "/terms": {
      "get": {
        "summary": "Terms of Service e AS-IS Disclaimer",
        "description": "Returns terms of service, liability limitations, and network parameters.",
        "tags": ["Legal"],
        "responses": {
          "200": {
            "description": "Terms of service JSON document"
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "summary": "Privacy Policy (LGPD Compliance)",
        "description": "Returns the privacy policy confirming zero PII collection and compliance with Brazilian LGPD (Lei nº 13.709/2018) and Marco Civil da Internet.",
        "tags": ["Legal"],
        "responses": {
          "200": {
            "description": "Privacy policy JSON document"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "x402Payment": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Payment",
        "description": "Transaction hash (0x + 64 hex characters) on Base Mainnet (Chain ID 8453) transferring 0.0005 USDC (standard) or 0.0020 USDC (CNPJ) to 0xa31c31069c43ac1c0075a93c325b0dcd7744356c. For free testing and CI/CD, pass value 'demo' to simulate in Sandbox mode (up to 20 calls/hour per IP)."
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment Required via x402 Protocol (Base Mainnet)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/X402Challenge"
            }
          }
        }
      }
    },
    "schemas": {
      "SummaryResponse": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string", "example": "x402" },
          "hub": { "type": "string", "example": "Grid402" },
          "network": { "type": "string", "example": "Base" },
          "chain_id": { "type": "integer", "example": 8453 },
          "status": { "type": "string", "example": "OPERATIONAL" },
          "timestamp": { "type": "string", "format": "date-time" },
          "services": { "type": "object" },
          "notice": { "type": "string" }
        }
      },
      "X402Challenge": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "PaymentRequired" },
          "message": { "type": "string" },
          "protocol": { "type": "string", "example": "x402" },
          "network": { "type": "string", "example": "Base" },
          "chain_id": { "type": "integer", "example": 8453 },
          "token": { "type": "string", "example": "USDC" },
          "token_contract": { "type": "string", "example": "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913" },
          "price_usdc": { "type": "string", "example": "0.0005" },
          "price_raw_units": { "type": "integer", "example": 500 },
          "recipient_wallet": { "type": "string", "example": "0xa31c31069c43ac1c0075a93c325b0dcd7744356c" },
          "action_required": { "type": "string" },
          "docs": { "type": "string", "example": "https://www.grid402.com.br/llms.txt" }
        }
      },
      "ForexResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "UP" },
          "timestamp": { "type": "string" },
          "rates": { "type": "object" }
        }
      },
      "CryptoResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "UP" },
          "timestamp": { "type": "string" },
          "tickers": { "type": "object" }
        }
      },
      "DnsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "domain": { "type": "string", "example": "github.com" },
          "records": { "type": "object" }
        }
      },
      "SslResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "host": { "type": "string", "example": "base.org" },
          "certificate": { "type": "object" }
        }
      },
      "AsnResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "ip": { "type": "string", "example": "1.1.1.1" },
          "asn": { "type": "string", "example": "AS13335" },
          "org": { "type": "string", "example": "Cloudflare, Inc." }
        }
      },
      "CepResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "cep": { "type": "string", "example": "01310-100" },
          "cidade": { "type": "string", "example": "São Paulo" },
          "uf": { "type": "string", "example": "SP" },
          "ibge": { "type": "string", "example": "3550308" }
        }
      },
      "CnpjResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "cnpj": { "type": "string", "example": "00000000000191" },
          "razao_social": { "type": "string", "example": "BANCO DO BRASIL SA" },
          "nome_fantasia": { "type": "string", "example": "DIRECAO GERAL" },
          "situacao_cadastral": { "type": "string", "example": "ATIVA" },
          "data_abertura": { "type": "string", "example": "01/08/1966" },
          "cnae_fiscal": { "type": "string", "example": "6422100" },
          "cnae_fiscal_descricao": { "type": "string", "example": "Bancos múltiplos, com carteira comercial" },
          "natureza_juridica": { "type": "string", "example": "Sociedade Anônima Aberta" },
          "uf": { "type": "string", "example": "DF" },
          "municipio": { "type": "string", "example": "BRASILIA" }
        }
      },
      "IndicatorsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "service": { "type": "string", "example": "indicators" },
          "timestamp": { "type": "string", "example": "2026-11-08T11:50:40Z" },
          "indicators": {
            "type": "object",
            "properties": {
              "selic_target": { "type": "number", "example": 13.75 },
              "selic_daily": { "type": "number", "example": 13.65 },
              "cdi_annual": { "type": "number", "example": 13.65 },
              "cdi_daily": { "type": "number", "example": 0.0508 },
              "ipca_12m": { "type": "number", "example": 4.58 },
              "ipca_monthly": { "type": "number", "example": 0.44 },
              "reference_date": { "type": "string", "example": "2026-11-08" },
              "ipca_reference_month": { "type": "string", "example": "2026-10" }
            }
          },
          "source": { "type": "string", "example": "Banco Central do Brasil e IBGE" },
          "cached": { "type": "boolean", "example": true }
        }
      },
      "HolidayItem": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "example": "2026-01-01" },
          "name": { "type": "string", "example": "Confraternizacao Universal" },
          "type": { "type": "string", "example": "national" },
          "day_of_week": { "type": "string", "example": "Quinta-feira" },
          "is_banking_holiday": { "type": "boolean", "example": true }
        }
      },
      "HolidaysResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "service": { "type": "string", "example": "holidays" },
          "year": { "type": "integer", "example": 2026 },
          "total_holidays": { "type": "integer", "example": 15 },
          "holidays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HolidayItem"
            }
          },
          "source": { "type": "string", "example": "Calendario Nacional e ANBIMA / Febraban" },
          "cached": { "type": "boolean", "example": true }
        }
      },
      "WorkdaysResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "service": { "type": "string", "example": "workdays" },
          "mode": { "type": "string", "example": "range" },
          "convention": { "type": "string", "example": "ANBIMA (exclusive start, inclusive end)" },
          "start_date": { "type": "string", "example": "2026-12-24" },
          "end_date": { "type": "string", "example": "2026-12-28" },
          "target_date": { "type": "string", "example": "2026-11-13" },
          "workdays": { "type": "integer", "example": 1 },
          "calendar_days": { "type": "integer", "example": 4 },
          "is_workday": { "type": "boolean", "example": true },
          "day_type": { "type": "string", "example": "workday" },
          "description": { "type": "string", "example": "Dia util bancario" },
          "holiday_name": { "type": "string", "nullable": true, "example": null },
          "next_workday": { "type": "string", "example": "2026-12-28" },
          "holidays_in_range": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "example": "2026-12-25" },
                "name": { "type": "string", "example": "Natal" }
              }
            }
          },
          "tariff_usdc": { "type": "string", "example": "0.0005" },
          "_oracle_proof": { "$ref": "#/components/schemas/OracleProof" }
        }
      },
      "OracleProof": {
        "type": "object",
        "description": "Cryptographic proof of data authenticity and non-repudiation signed by the official Grid402 Oracle",
        "properties": {
          "oracle_address": { "type": "string", "example": "0xa31c31069c43ac1c0075a93c325b0dcd7744356c" },
          "timestamp": { "type": "integer", "example": 1794140000 },
          "data_hash": { "type": "string", "example": "0x4f8a12b3c4d5e6f7..." },
          "signature": { "type": "string", "example": "0x3045022100..." },
          "algorithm": { "type": "string", "example": "secp256k1-sha256" },
          "sandbox": { "type": "boolean", "example": false }
        },
        "required": ["oracle_address", "timestamp", "data_hash", "signature", "algorithm", "sandbox"]
      },
      "VerifyResponse": {
        "type": "object",
        "description": "Result of cryptographic verification of an oracle-signed response",
        "properties": {
          "valid": { "type": "boolean", "example": true },
          "oracle_address": { "type": "string", "example": "0xa31c31069c43ac1c0075a93c325b0dcd7744356c" },
          "timestamp": { "type": "integer", "example": 1794163887 },
          "sandbox": { "type": "boolean", "example": true },
          "verification_time_ms": { "type": "number", "example": 0.38 },
          "hub": { "type": "string", "example": "Grid402" },
          "status": { "type": "string", "example": "AUTHENTIC_ORACLE_DATA" },
          "error": { "type": "string", "example": "DataHashMismatch" },
          "expected_hash": { "type": "string", "example": "0xd93ff92161897e911b85afed59a209170e4ae04d449bf4213dca7dba1f1fcaad" },
          "received_hash": { "type": "string", "example": "0x92b36d33af465b9fc16f221db86d5640c40efd1a3d7c51b10d15d14a982fb9bc" }
        },
        "required": ["valid", "verification_time_ms", "hub", "status"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}

