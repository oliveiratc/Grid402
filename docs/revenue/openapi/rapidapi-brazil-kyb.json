    "/api/v1/cnpj": {
      "get": {
        "summary": "Brazilian Federal Revenue Corporate CNPJ Lookup",
        "description": "Retrieves public corporate registration data, status, CNAE economic activities, and address from Brazilian Receita Federal. Requires x402 micropayment of 0.0200 USDC on Base.",
        "tags": [
          "CNPJ"
        ],
        "parameters": [
          {
            "name": "cnpj",
            "in": "query",
            "required": true,
            "description": "14-digit Brazilian CNPJ number (with or without formatting)",
            "schema": {
              "type": "string",
              "example": "00000000000191"
            },
            "example": "00000000000191"
          }
        ],
        "responses": {
          "200": {
            "description": "Corporate registration data returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CnpjResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid CNPJ format or checksum failure"
          }
        }
      }
    },
