    "/api/v1/workdays": {
      "get": {
        "summary": "ANBIMA Financial Workdays Calculator",
        "description": "Calculates Brazilian banking workdays according to official ANBIMA convention. Supports 3 operation modes: date range counting (exclusive start, inclusive end), maturity date projection (+/- N workdays), and single-date workday verification. Settled via x402 on Base (0.0050 USDC) or free in Sandbox mode.",
        "tags": [
          "Workdays"
        ],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "description": "Initial reference date in ISO 8601 format (YYYY-MM-DD). Defaults to today.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-12-24"
            },
            "example": "2026-12-24"
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "End date in ISO 8601 format (YYYY-MM-DD) for interval counting mode.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-12-28"
            },
            "example": "2026-12-28"
          },
          {
            "name": "days",
            "in": "query",
            "description": "Number of workdays to add (positive) or subtract (negative) for projection mode (max 5000).",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 5
            },
            "example": 5
          },
          {
            "name": "date",
            "in": "query",
            "description": "Single date in ISO 8601 format (YYYY-MM-DD) for single-date check mode.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-12-25"
            },
            "example": "2026-12-25"
          }
        ],
        "responses": {
          "200": {
            "description": "Workdays calculation returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkdaysResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date format, range or displacement exceeding limits"
          }
        }
      }
    },
    "/api/v1/holidays": {
      "get": {
        "summary": "Brazilian National Holidays and Banking Calendar",
        "description": "Returns full official schedule of Brazilian national holidays and non-banking days (ANBIMA and Febraban) for a given year (1900-2100). Computes mobile holidays deterministically using Meeus algorithm. Settled via x402 on Base (0.0050 USDC). Free teaser preview with next holiday available on 402 challenge.",
        "tags": [
          "Holidays"
        ],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Four-digit calendar year (e.g., 2026). Defaults to current year.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100,
              "example": 2026
            },
            "example": 2026
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar of holidays returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolidaysResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid year parameter (must be between 1900 and 2100)"
          }
        }
      }
    },
